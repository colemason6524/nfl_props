[Unit]
Description=nfl_props late-pregame injury refresh (injury pull + board regen, NFL)
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/nfl_props/scripts/run_nfl_linux_task.sh

[Service]
Type=oneshot
WorkingDirectory=/home/azureuser/nfl_props
ExecStart=%h/nfl_props/scripts/run_nfl_linux_task.sh pregame-refresh
TimeoutStartSec=50min
