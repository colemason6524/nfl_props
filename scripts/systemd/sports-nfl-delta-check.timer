[Unit]
Description=NFL delta check - 10 min after Thu/Sun/Mon boards (silent)

[Timer]
OnCalendar=Thu *-*-* 19:45:00 America/New_York
OnCalendar=Sun *-*-* 15:47:00 America/New_York
OnCalendar=Mon *-*-* 23:45:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=sports-nfl-delta-check.service

[Install]
WantedBy=timers.target
