[Unit]
Description=nfl_props late-pregame injury refresh (injury pull + board regen, NFL)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=azureuser
WorkingDirectory=/home/azureuser/nfl_props
ExecStart=/home/azureuser/nfl_props/scripts/run_nfl_linux_task.sh pregame-refresh
TimeoutStartSec=50min
